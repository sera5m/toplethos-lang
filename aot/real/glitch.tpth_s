  };
  i32 outp[1200];
  i32 n = 1200;
  i32 heap = (n - 2) / 2;
  i32 last = n - 1;
  loop {
    i32 root = heap;
    loop {
      i32 child = root * 2 + 1;
      if child > last { leave; }
      if child + 1 <= last {
        if before in[ord[child], ord[child + 1]] { child = child + 1; }
      }
      if before in[ord[root], ord[child]] {
        i32 tmp = ord[root];
        ord[root] = ord[child];
        ord[child] = tmp;
        root = child;
      } else {
        leave;
      }
    }
    if heap == 0 { leave; }
    heap = heap - 1;
  }
  i32 end = n - 1;
  loop {
    if !(end > 0) { leave; }
    i32 tmp = ord[0];
    ord[0] = ord[end];
    ord[end] = tmp;
    end = end - 1;
    i32 root = 0;
    loop {
      i32 child = root * 2 + 1;
      if child > end { leave; }
      if child + 1 <= end {
        if before in[ord[child], ord[child + 1]] { child = child + 1; }
      }
      if before in[ord[root], ord[child]] {
        i32 swap = ord[root];
        ord[root] = ord[child];
        ord[child] = swap;
        root = child;
      } else {
        leave;
      }
    }
  }
  i32 w = 40;
  i32 h = 30;
  i32 cx = w / 2;
  i32 cy = h / 2;
  do n[30] {
    i32 y = i;
    do n[40] {
      i32 x = i;
      i32 dx = x - cx;
      i32 dy = y - cy;
      i32 ax = dx;
      i32 ay = dy;
      if ax < 0 { ax = 0 - ax; }
      if ay < 0 { ay = 0 - ay; }
      i32 rad = 0;
      if ax > ay { rad = ax + ay / 2; } else { rad = ay + ax / 2; }
      i32 ang = iatan2 in[dy, dx];
      i32 idx = rad * 3 + ang;
      idx = idx - (idx / n) * n;
      i32 p = ord[idx];
      i32 r = p / 65536;
      i32 g = p / 256 - r * 256;
      i32 b = p - p / 256 * 256;
      i32 m = rad - (rad / 3) * 3;
      if m == 0 {
        i32 t = r;
        r = b;
        b = t;
      }
      if m == 1 {
        i32 t = r;
        r = g;
        g = b;
        b = t;
      }
      outp[y * w + x] = r * 65536 + g * 256 + b;
    }
  }
  do n[30] {
    i32 y = i;
    if y - (y / 17) * 17 == 0 {
      i32 shift = y - (y / 5) * 5 - 2;
      i32 row[40];
      i32 x = 0;
      loop {
        if !(x < w) { leave; }
        i32 srcx = x - shift;
        loop {
          if !(srcx < 0) { leave; }
          srcx = srcx + w;
        }
        loop {
          if !(srcx >= w) { leave; }
          srcx = srcx - w;
        }
        row[x] = outp[y * w + srcx];
        x = x + 1;
      }
      x = 0;
      loop {
        if !(x < w) { leave; }
        outp[y * w + x] = row[x];
        x = x + 1;
      }
    }
  }
  i64 sum = 0;
  do n[1200] { sum = sum + as[i64, outp[i]]; }
  print in[sum];
  return 0;
}
