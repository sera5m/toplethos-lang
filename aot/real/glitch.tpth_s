// 40x30 of the night photo. Sort by luminance, paint rings, tear channels.
// Same integer steps as glitch.cpp. The frame is in the source because this host cannot read a file.
fn lum in[i32 p] out[i32] {
  i32 r = p / 65536;
  i32 g = p / 256 - r * 256;
  i32 b = p - p / 256 * 256;
  return r + r + g * 5 + b;
}

fn before in[i32 a, i32 b] out[bool] {
  i32 la = lum in[a];
  i32 lb = lum in[b];
  if la != lb { return la < lb; }
  return a < b;
}

fn iatan2 in[i32 y, i32 x] out[i32] {
  i32 ax = x;
  i32 ay = y;
  if ax < 0 { ax = 0 - ax; }
  if ay < 0 { ay = 0 - ay; }
  if (ax == 0) && (ay == 0) { return 0; }
  i32 a = 0;
  if ax > ay {
    a = ay * 32 / ax;
  } else {
    a = 64 - ax * 32 / ay;
  }
  if (x >= 0) && (y >= 0) { return a; }
  if (x < 0) && (y >= 0) { return 128 - a; }
  if (x < 0) && (y < 0) { return 128 + a; }
  if a == 0 { return 0; }
  return 256 - a;
}

