// One program. direct, then call, then object. Same Horner, same order.
// x = i * 0.000001, i = 0 .. 1999999.
// Both hosts run this file. The clock is outside the program.
//
// python3 aot/tpc.py aot/battery.tpth_s -o /tmp/battery_tp --run
// python3 toplethos_run.py aot/battery.tpth_s

fn horner in[f64 x] out[f64] {
  f64 y = 8.0;
  y = 7.0 + x * y;
  y = 6.0 + x * y;
  y = 5.0 + x * y;
  y = 4.0 + x * y;
  y = 3.0 + x * y;
  y = 2.0 + x * y;
  y = 1.0 + x * y;
  return y;
}

object Poly {
  f64 c0;
  f64 c1;
  f64 c2;
  f64 c3;
  f64 c4;
  f64 c5;
  f64 c6;
  f64 c7;
  fn eval in[f64 x] out[f64] {
    f64 y = HERE.c7;
    y = HERE.c6 + x * y;
    y = HERE.c5 + x * y;
    y = HERE.c4 + x * y;
    y = HERE.c3 + x * y;
    y = HERE.c2 + x * y;
    y = HERE.c1 + x * y;
    y = HERE.c0 + x * y;
    return y;
  }
}

fn main in[] out[i32] {
  Poly p;
  p.c0 = 1.0;
  p.c1 = 2.0;
  p.c2 = 3.0;
  p.c3 = 4.0;
  p.c4 = 5.0;
  p.c5 = 6.0;
  p.c6 = 7.0;
  p.c7 = 8.0;

  f64 s = 0.0;
  f64 x = 0.0;
  f64 y = 0.0;
  do n[2000000] {
    x = as[f64, i] * 0.000001;
    y = 8.0;
    y = 7.0 + x * y;
    y = 6.0 + x * y;
    y = 5.0 + x * y;
    y = 4.0 + x * y;
    y = 3.0 + x * y;
    y = 2.0 + x * y;
    y = 1.0 + x * y;
    s = s + y;
  }
  print in[s];

  s = 0.0;
  do n[2000000] {
    x = as[f64, i] * 0.000001;
    s = s + horner in[x];
  }
  print in[s];

  s = 0.0;
  do n[2000000] {
    x = as[f64, i] * 0.000001;
    s = s + p.eval in[x];
  }
  print in[s];
  return 0;
}
