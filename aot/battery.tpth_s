// The rows this compiler can lower: direct, call, object.
// Same Horner and same N as battery.cpp and battery.rs.
// Threads, async, checked, raw, and mutex are in those two files.
// This compiler does not lower them yet.
//
// python3 aot/tpc.py aot/battery.tpth_s -o /tmp/battery_tp

fn horner in[f64 x] out[f64] {
  f64 y = 8.0;
  y = 7.0 + x * y;
  y = 6.0 + x * y;
  y = 5.0 + x * y;
  y = 4.0 + x * y;
  y = 3.0 + x * y;
  y = 2.0 + x * y;
  y = 1.0 + x * y;
  return y;
}

object Poly {
  f64 c0;
  f64 c1;
  f64 c2;
  f64 c3;
  f64 c4;
  f64 c5;
  f64 c6;
  f64 c7;
  fn eval in[f64 x] out[f64] {
    f64 y = HERE.c7;
    y = HERE.c6 + x * y;
    y = HERE.c5 + x * y;
    y = HERE.c4 + x * y;
    y = HERE.c3 + x * y;
    y = HERE.c2 + x * y;
    y = HERE.c1 + x * y;
    y = HERE.c0 + x * y;
    return y;
  }
}

Poly p;
p.c0 = 1.0;
p.c1 = 2.0;
p.c2 = 3.0;
p.c3 = 4.0;
p.c4 = 5.0;
p.c5 = 6.0;
p.c6 = 7.0;
p.c7 = 8.0;

i32 n = 2000000;
i32 i = 0;
f64 s = 0.0;
f64 x = 0.0;
f64 y = 0.0;

tp_begin in["direct"];
loop {
  if !(i < n) { leave; }
  x = as[f64, i] * 0.000001;
  y = 8.0;
  y = 7.0 + x * y;
  y = 6.0 + x * y;
  y = 5.0 + x * y;
  y = 4.0 + x * y;
  y = 3.0 + x * y;
  y = 2.0 + x * y;
  y = 1.0 + x * y;
  s = s + y;
  i = i + 1;
}
tp_end in[s];

tp_begin in["call"];
s = 0.0;
i = 0;
loop {
  if !(i < n) { leave; }
  x = as[f64, i] * 0.000001;
  s = s + horner in[x];
  i = i + 1;
}
tp_end in[s];

tp_begin in["object"];
s = 0.0;
i = 0;
loop {
  if !(i < n) { leave; }
  x = as[f64, i] * 0.000001;
  s = s + p.eval in[x];
  i = i + 1;
}
tp_end in[s];
tp_threads in[n];
