/* Hands 64 values to ./two_funcs and reads both results back.
   Compile gpu/two_funcs first, then run this from the repo root.
   xs[0] is 1. f(1) is -598429147. g(1) is -312617107.
   This is a process call, not foreign. foreign is still rejected. */
fn main in[] out[i32] {
i32 xs[64];
i32 fs[64];
i32 gs[64];
i32 i = 0;
loop {
if !(i < 64) { leave; }
xs[i] = i + 1;
i = i + 1;
}
gputwo in[xs, fs, gs];
print in[fs[0]];
print in[gs[0]];
if fs[0] != -598429147 { return 1; }
if gs[0] != -312617107 { return 1; }
return 0;
}
