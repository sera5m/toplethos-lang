// Night street. The photo is examples/street.bmp, 1732 by 1299.
// Sort by luminance, paint rings around the lamp, tear channels, shift every 17th row.
// The two frames are @static. A stack array of this size would not fit.
// Same integer steps as examples/glitch.cpp. Run: sh examples/glitch.sh
fn lum in[i32 p] out[i32] {
  i32 r = p / 65536;
  i32 g = p / 256 - r * 256;
  i32 b = p - p / 256 * 256;
  return r + r + g * 5 + b;
}

fn before in[i32 a, i32 b] out[bool] {
  i32 la = lum in[a];
  i32 lb = lum in[b];
  if la != lb { return la < lb; }
  return a < b;
}

fn iatan2 in[i32 y, i32 x] out[i32] {
  i32 ax = x;
  i32 ay = y;
  if ax < 0 { ax = 0 - ax; }
  if ay < 0 { ay = 0 - ay; }
  if (ax == 0) && (ay == 0) { return 0; }
  i32 a = 0;
  if ax > ay {
    a = ay * 32 / ax;
  } else {
    a = 64 - ax * 32 / ay;
  }
  if (x >= 0) && (y >= 0) { return a; }
  if (x < 0) && (y >= 0) { return 128 - a; }
  if (x < 0) && (y < 0) { return 128 + a; }
  if a == 0 { return 0; }
  return 256 - a;
}

fn main in[] out[i32] {
  i32 ord[2249868] @static;
  i32 outp[2249868] @static;
  loadbmp in["examples/street.bmp", ord];
  i32 n = 2249868;
  i32 w = 1732;
  i32 h = 1299;
  i32 heap = (n - 2) / 2;
  i32 last = n - 1;
  loop {
    i32 root = heap;
    loop {
      i32 child = root * 2 + 1;
      if child > last { leave; }
      if child + 1 <= last {
        if before in[ord[child], ord[child + 1]] { child = child + 1; }
      }
      if before in[ord[root], ord[child]] {
        i32 tmp = ord[root];
        ord[root] = ord[child];
        ord[child] = tmp;
        root = child;
      } else {
        leave;
      }
    }
    if heap == 0 { leave; }
    heap = heap - 1;
  }
  i32 end = n - 1;
  loop {
    if !(end > 0) { leave; }
    i32 tmp = ord[0];
    ord[0] = ord[end];
    ord[end] = tmp;
    end = end - 1;
    i32 root = 0;
    loop {
      i32 child = root * 2 + 1;
      if child > end { leave; }
      if child + 1 <= end {
        if before in[ord[child], ord[child + 1]] { child = child + 1; }
      }
      if before in[ord[root], ord[child]] {
        i32 swap = ord[root];
        ord[root] = ord[child];
        ord[child] = swap;
        root = child;
      } else {
        leave;
      }
    }
  }
  i32 cx = w / 2;
  i32 cy = h / 2;
  i32 maxr = 1;
  do n[1299] {
    i32 y = i;
    do n[1732] {
      i32 x = i;
      i32 dx = x - cx;
      i32 dy = y - cy;
      i32 ax = dx;
      i32 ay = dy;
      if ax < 0 { ax = 0 - ax; }
      if ay < 0 { ay = 0 - ay; }
      i32 rad = 0;
      if ax > ay { rad = ax + ay / 2; } else { rad = ay + ax / 2; }
      if rad > maxr { maxr = rad; }
    }
  }
  i32 lo = lum in[ord[0]];
  i32 hi = lum in[ord[n - 1]];
  if hi <= lo { hi = lo + 1; }
  i32 span = hi - lo;
  do n[1299] {
    i32 y = i;
    do n[1732] {
      i32 x = i;
      i32 dx = x - cx;
      i32 dy = y - cy;
      i32 ax = dx;
      i32 ay = dy;
      if ax < 0 { ax = 0 - ax; }
      if ay < 0 { ay = 0 - ay; }
      i32 rad = 0;
      if ax > ay { rad = ax + ay / 2; } else { rad = ay + ax / 2; }
      i32 ang = iatan2 in[dy, dx];
      i32 target = hi - rad * span / maxr;
      target = target - ang * span / 2048;
      if target < lo { target = lo; }
      if target > hi { target = hi; }
      i32 a = 0;
      i32 right = n - 1;
      loop {
        if !(a < right) { leave; }
        i32 mid = (a + right + 1) / 2;
        if lum in[ord[mid]] <= target { a = mid; } else { right = mid - 1; }
      }
      i32 p = ord[a];
      i32 r = p / 65536;
      i32 g = p / 256 - r * 256;
      i32 b = p - p / 256 * 256;
      i32 m = rad - (rad / 3) * 3;
      if m == 0 {
        i32 t = r;
        r = b;
        b = t;
      }
      if m == 1 {
        i32 t = r;
        r = g;
        g = b;
        b = t;
      }
      outp[y * w + x] = r * 65536 + g * 256 + b;
    }
  }
  do n[1299] {
    i32 y = i;
    if y - (y / 17) * 17 == 0 {
      i32 shift = y - (y / 5) * 5 - 2;
      i32 row[1732];
      i32 x = 0;
      loop {
        if !(x < w) { leave; }
        i32 srcx = x - shift;
        loop {
          if !(srcx < 0) { leave; }
          srcx = srcx + w;
        }
        loop {
          if !(srcx >= w) { leave; }
          srcx = srcx - w;
        }
        row[x] = outp[y * w + srcx];
        x = x + 1;
      }
      x = 0;
      loop {
        if !(x < w) { leave; }
        outp[y * w + x] = row[x];
        x = x + 1;
      }
    }
  }
  i64 sum = 0;
  do n[2249868] { sum = sum + as[i64, outp[i]]; }
  print in[sum];
  return 0;
}
